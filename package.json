{
  "name": "pi-tgbot",
  "version": "0.1.0",
  "private": true,
  "files": [
    "src/",
    "scripts/",
    "systemd/",
    "README.md",
    "LICENSE",
    "config.example.json",
    "check-pi-update.sh",
    "tsconfig.json",
    "!**/*.bak",
    "!**/*.bak.*"
  ],
  "type": "module",
  "description": "Security-conscious single-operator Telegram daemon for the pi coding agent SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/harrylyu2006/pi-tgbot.git"
  },
  "bugs": {
    "url": "https://github.com/harrylyu2006/pi-tgbot/issues"
  },
  "homepage": "https://github.com/harrylyu2006/pi-tgbot#readme",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "probe": "node scripts/probe.ts",
    "check": "tsc --noEmit",
    "test": "npm run check && npm run test:render && npm run test:redact && npm run test:ui && npm run test:activity && npm run test:reasoning && npm run test:state && npm run test:session-lifecycle && npm run test:steering && npm run test:idle-watchdog && npm run test:panel && npm run test:poller && npm run test:security && npm run test:upload && npm run test:web-access && npm run publication-check",
    "test:render": "node scripts/render-check.ts",
    "test:redact": "node scripts/redact-check.ts",
    "test:ui": "node scripts/ui-failclosed.ts",
    "test:activity": "node scripts/activity-check.ts",
    "test:reasoning": "node scripts/reasoning-check.ts && node scripts/reasoning-payload-check.ts && node scripts/reasoning-anthropic-payload-check.ts",
    "test:state": "node scripts/state-check.ts",
    "test:session-lifecycle": "node scripts/session-lifecycle-check.ts",
    "test:steering": "node scripts/steering-check.ts",
    "test:idle-watchdog": "node scripts/idle-watchdog-check.ts",
    "test:panel": "node scripts/panel-check.ts",
    "test:poller": "node scripts/poller-check.ts",
    "test:security": "node scripts/security-check.ts",
    "test:upload": "node scripts/upload-check.ts",
    "test:web-access": "node scripts/web-access-check.ts",
    "publication-check": "node scripts/publication-check.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "pi-web-access": "0.18.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
